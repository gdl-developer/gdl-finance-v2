# GDL V2 Staging Environment Template

# API Gateway
PORT=3000
NODE_ENV=staging
ALLOWED_ORIGINS=https://staging.gdl.com.ng,http://localhost:3000
COOKIE_SECRET=replace-with-a-secure-secret
JWT_SECRET=replace-with-a-secure-secret

# Identity Service (gRPC)
IDENTITY_SERVICE_URL=identity-service:50052
DB_HOST=identity.db
DB_TYPE=sqlite

# External Integrations (Staging)
BANKONE_API_KEY=your-staging-key
UBA_CLIENT_ID=your-staging-id
RM_KEY=your-staging-key
