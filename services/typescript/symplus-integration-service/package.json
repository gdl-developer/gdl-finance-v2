    "@types/bcryptjs": "^2.4.6",
    "@types/crypto-js": "^4.0.1",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/node-fetch": "^2.5.10",
    "@types/passport-jwt": "^3.0.5",
    "@types/passport-local": "^1.0.33",
    "@types/request-ip": "^0.0.41",
